# Copia este archivo como .env (instalar.sh lo hace solo) y ajusta lo que necesites.

# Modelo que responde las preguntas. Elige según tu equipo (ver README):
#   8 GB de RAM o tarjeta de 4 GB -> qwen3:4b      16 GB -> qwen3:8b      32 GB o más -> qwen3:30b
MODELO_CHAT=qwen3:4b

# Modelo que "indexa" los documentos para buscarlos. bge-m3 entiende bien el español.
# Si lo cambias después de haber subido documentos, hay que volver a subirlos.
MODELO_EMBEDDINGS=bge-m3

# Tokens de contexto que el modelo puede leer de una vez (más = más RAM).
CONTEXTO_TOKENS=8192

# Puerto de la interfaz web: http://IP-DEL-ZIMA:3000
PUERTO_WEB=3000

# Clave entre Open WebUI y el conversor (instalar.sh genera una aleatoria).
CONVERSOR_API_KEY=cambia-esta-clave
